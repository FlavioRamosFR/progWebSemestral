# Porta da API (o front Next.js já usa a 3000)
PORT=3001

# Endereço do front autorizado pelo CORS (separe vários com vírgula)
FRONTEND_ORIGIN=http://localhost:3000

# Segredo que assina o cookie de sessão: troque por um texto longo e aleatório
SESSION_SECRET=troque_por_um_segredo_longo

# Usuários criados quando a tabela de usuários está vazia
ADM_EMAIL=admin@rgr.com
ADM_SENHA=troque_esta_senha
FUNCIONARIO_EMAIL=funcionario@rgr.com
FUNCIONARIO_SENHA=troque_esta_senha

# Banco MySQL: use DATABASE_URL OU as variáveis DB_* separadas
# DATABASE_URL=mysql://usuario:senha@host:3306/rgr
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rgr
DB_PASSWORD=troque_esta_senha
DB_NAME=rgr

# Banco usado pelo npm test (é apagado a cada execução: nunca use o banco principal)
TEST_DB_NAME=rgr_teste

# Fuso horário das vendas (Mato Grosso do Sul: -04:00; Brasília: -03:00)
DB_TIMEZONE=-04:00

# Bancos em nuvem: DB_SSL=true e, se o provedor fornecer, o certificado em DB_SSL_CA
DB_SSL=false
# DB_SSL_CA=

# Produção
# NODE_ENV=production   (cookie só por HTTPS)
# TRUST_PROXY=2         (quantidade de proxies na frente da API; veja DEPLOY.md)
# LIMITE_GERAL=300      (requisições por IP a cada 15 minutos)
# LIMITE_LOGIN=10       (tentativas de login erradas por IP a cada 15 minutos)
