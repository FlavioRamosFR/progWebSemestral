{
  "name": "backend-prog-web-semestral",
  "version": "1.0.0",
  "description": "API do Sistema de Vendas RGR: produtos, fornecedores, relatórios e login com perfis de acesso.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest",
    "db:criar": "node scripts/criarBanco.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/src/test/prepararBanco.js",
    "setupFiles": [
      "<rootDir>/src/test/ambiente.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/limparBanco.js"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "testTimeout": 20000,
    "maxWorkers": 1
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
